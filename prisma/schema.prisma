generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ============ AUTH (NextAuth standard) ============

model User {
  id                String    @id @default(cuid())
  role              UserRole  @default(USER)
  phone             String    @unique
  email             String?   @unique
  emailVerified     DateTime?
  name              String?
  image             String?

  // Notifications
  notifyEmail       Boolean   @default(true)
  notifySms         Boolean   @default(true)
  notifyTelegram    Boolean   @default(false)
  telegramId        String?   @unique
  remindDaysBefore  Int[]     @default([30, 14, 3])

  // Bonuses
  bonusBalance      Int       @default(0)
  bonusLevel        BonusLevel @default(BRONZE)
  totalSpent        Int       @default(0)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  cars              Car[]
  bookings          Booking[]
  orders            Order[]
  bonuses           BonusTransaction[]
  documents         Document[]

  // NextAuth
  accounts          Account[]
  sessions          Session[]
}

enum UserRole {
  USER
  MASTER
  ADMIN
}

enum BonusLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ CARS ============

model Car {
  id                  String      @id @default(cuid())
  userId              String
  brand               CarBrand
  model               String
  year                Int
  vin                 String?     @unique
  licensePlate        String?
  mileage             Int
  mileageUpdatedAt    DateTime    @default(now())
  purchaseDate        DateTime?
  color               String?
  engineVolume        Float?
  fuelType            FuelType?
  transmission        Transmission?
  notes               String?     @db.Text
  isActive            Boolean     @default(true)

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders           MaintenanceReminder[]
  orders              Order[]
  bookings            Booking[]
  documents           Document[]

  @@index([userId])
}

enum CarBrand {
  BMW
  MERCEDES
  AUDI
  PORSCHE
  SKODA
  VW
  OTHER
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
}

enum Transmission {
  MANUAL
  AUTOMATIC
  DSG
  CVT
}

// ============ SERVICES ============

model Service {
  id                String          @id @default(cuid())
  slug              String          @unique
  title             String
  shortDescription  String          @db.Text
  fullDescription   String?         @db.Text
  category          ServiceCategory
  durationMinutes   Int
  basePrice         Int
  priceByBrand      Json?           // { "BMW": 5000, "MERCEDES": 5500, ... }
  isActive          Boolean         @default(true)
  isFlagship        Boolean         @default(false)
  isExclusive       Boolean         @default(false)
  sortOrder         Int             @default(0)
  iconName          String?
  heroImageUrl      String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  bookings          Booking[]
  orderItems        OrderItem[]
}

enum ServiceCategory {
  DIAGNOSTICS
  MAINTENANCE
  ENGINE
  TRANSMISSION
  BRAKES
  SUSPENSION
  ELECTRICAL
  TUNING
  BODY
  TIRES
  AC
}

// ============ BRANCHES ============

model Branch {
  id                String    @id @default(cuid())
  slug              String    @unique
  name              String
  address           String
  city              String    @default("Краснодар")
  latitude          Float
  longitude         Float
  phone             String
  email             String?
  openHours         Json      // { "mon": "08:00-19:00", ... }
  brandsSupported   CarBrand[]
  capacity          Int       @default(10)
  photos            Json?
  isActive          Boolean   @default(true)
  isHQ              Boolean   @default(false)
  sortOrder         Int       @default(0)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  bookings          Booking[]
  orders            Order[]
}

// ============ BOOKINGS ============

model Booking {
  id              String         @id @default(cuid())

  // Если userId — авторизованный, иначе гостевые поля
  userId          String?
  guestName       String?
  guestPhone      String?
  guestEmail      String?

  // Авто (если userId — carId, иначе guest fields)
  carId           String?
  guestCarBrand   CarBrand?
  guestCarModel   String?
  guestCarYear    Int?

  serviceId       String
  branchId        String

  scheduledAt     DateTime
  durationMinutes Int

  status          BookingStatus  @default(PENDING)
  source          BookingSource  @default(WEB)
  notes           String?        @db.Text

  estimatedPrice  Int?
  depositAmount   Int?           @default(0)
  depositStatus   DepositStatus  @default(NONE)

  reminderSentAt  DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  car             Car?           @relation(fields: [carId], references: [id], onDelete: SetNull)
  service         Service        @relation(fields: [serviceId], references: [id])
  branch          Branch         @relation(fields: [branchId], references: [id])
  order           Order?

  @@index([userId])
  @@index([branchId, scheduledAt])
  @@index([status])
}

enum BookingStatus {
  DRAFT
  PENDING
  CONFIRMED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  WEB
  PHONE
  TELEGRAM
  ADMIN
}

enum DepositStatus {
  NONE
  HELD
  PAID
  REFUNDED
}

// ============ ORDERS ============

model Order {
  id                String       @id @default(cuid())
  number            String       @unique // "KAN-2026-001234"
  bookingId         String?      @unique
  userId            String
  carId             String
  branchId          String

  startedAt         DateTime     @default(now())
  completedAt       DateTime?
  status            OrderStatus  @default(IN_PROGRESS)

  totalAmount       Int          @default(0)
  partsAmount       Int          @default(0)
  laborAmount       Int          @default(0)
  discountAmount    Int          @default(0)

  warrantyMonths    Int          @default(12)
  warrantyKm        Int          @default(20000)
  warrantyStartDate DateTime     @default(now())

  masterName        String?
  mileageAtService  Int
  documentUrl       String?
  rating            Int?
  reviewText        String?      @db.Text

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user              User                @relation(fields: [userId], references: [id])
  car               Car                 @relation(fields: [carId], references: [id])
  branch            Branch              @relation(fields: [branchId], references: [id])
  booking           Booking?            @relation(fields: [bookingId], references: [id])
  items             OrderItem[]
  bonusTransaction  BonusTransaction[]
  documents         Document[]

  @@index([userId])
  @@index([carId])
  @@index([status])
}

enum OrderStatus {
  IN_PROGRESS
  COMPLETED
  WARRANTY_CASE
  CANCELLED
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  serviceId   String?
  title       String
  description String?         @db.Text
  quantity    Int             @default(1)
  unitPrice   Int
  totalPrice  Int
  type        OrderItemType
  partOrigin  PartOrigin?
  partNumber  String?

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service     Service?        @relation(fields: [serviceId], references: [id])
}

enum OrderItemType {
  LABOR
  PART
}

enum PartOrigin {
  ORIGINAL
  ANALOG
  USED
}

// ============ MAINTENANCE ============

model MaintenanceRule {
  id              String                @id @default(cuid())
  type            MaintenanceType
  brand           CarBrand?             // null = универсальное правило
  intervalKm      Int?
  intervalMonths  Int?
  severity        MaintenanceSeverity   @default(RECOMMENDED)
  description     String                @db.Text
  estimatedPrice  Int?
  isActive        Boolean               @default(true)

  reminders       MaintenanceReminder[]

  @@index([brand, type])
}

model MaintenanceReminder {
  id              String                  @id @default(cuid())
  carId           String
  ruleId          String
  type            MaintenanceType

  lastDoneAt      DateTime?
  lastDoneMileage Int?

  dueAt           DateTime
  dueAtMileage    Int

  status          MaintenanceStatus       @default(PENDING)
  notifiedAt      DateTime?
  snoozedUntil    DateTime?
  snoozeReason    String?

  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  car             Car                     @relation(fields: [carId], references: [id], onDelete: Cascade)
  rule            MaintenanceRule         @relation(fields: [ruleId], references: [id])

  @@index([carId])
  @@index([status, dueAt])
}

enum MaintenanceType {
  OIL_ENGINE
  OIL_TRANSMISSION
  FILTER_AIR
  FILTER_FUEL
  FILTER_CABIN
  FILTER_OIL
  TIMING_BELT
  TIMING_CHAIN
  COOLANT
  BRAKE_FLUID
  POWER_STEERING_FLUID
  SPARK_PLUGS
  BRAKE_PADS_FRONT
  BRAKE_PADS_REAR
  BRAKE_DISCS
  TIRE_SEASON
  WHEEL_ALIGNMENT
  FULL_SERVICE_1
  FULL_SERVICE_2
  AC_REFILL
}

enum MaintenanceSeverity {
  CRITICAL
  RECOMMENDED
  OPTIONAL
}

enum MaintenanceStatus {
  PENDING
  UPCOMING
  DUE
  OVERDUE
  DONE
  SNOOZED
}

// ============ BONUSES ============

model BonusTransaction {
  id            String              @id @default(cuid())
  userId        String
  orderId       String?
  amount        Int                 // +/- баллы
  type          BonusTransactionType
  description   String
  balanceAfter  Int
  expiresAt     DateTime?

  createdAt     DateTime            @default(now())

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  order         Order?              @relation(fields: [orderId], references: [id])

  @@index([userId])
}

enum BonusTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
  WELCOME
  REFERRAL
}

// ============ DOCUMENTS ============

model Document {
  id            String        @id @default(cuid())
  userId        String
  carId         String?
  orderId       String?
  type          DocumentType
  fileUrl       String
  fileName      String
  fileSizeBytes Int
  mimeType      String

  createdAt     DateTime      @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  car           Car?          @relation(fields: [carId], references: [id], onDelete: SetNull)
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
}

enum DocumentType {
  ORDER_FORM
  WARRANTY
  INVOICE
  ACT
  PHOTO
  OTHER
}
