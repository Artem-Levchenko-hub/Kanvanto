# Database (Neon Postgres рекомендуется)
DATABASE_URL="postgresql://user:password@host:5432/kanavto?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/kanavto?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate via: openssl rand -base64 32"

# OAuth
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Kanavto <noreply@kanavto.com>"

# SMS (SMSC.ru)
SMSC_LOGIN=""
SMSC_PASSWORD=""

# Yandex Maps
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=""

# VIN-decoder
VIN_DECODER_PROVIDER="datsu"
VIN_DECODER_API_KEY=""

# Storage
BLOB_READ_WRITE_TOKEN=""

# Cron protection
CRON_SECRET="generate via: openssl rand -hex 32"

# Telegram (опц.)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="kanavto_bot"
TELEGRAM_WEBHOOK_SECRET=""

# ЮKassa (этап 5 — депозит за бронирование)
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# VIN-decoder providers (этап 5 — datsu.ru / autodev.ru / vindecoder.eu)
# При наличии ключа — обогащает локальную WMI-декодировку моделью, двигателем, КПП
VIN_DECODER_PROVIDER="datsu"
VIN_DECODER_API_KEY=""
VIN_DECODER_SECRET=""

# Analytics
NEXT_PUBLIC_YM_ID=""

# A/B-эксперименты (опц., авто-генерация cookies в middleware)
AB_HERO_HEADLINE_ENABLED="false"
AB_CTA_TEXT_ENABLED="false"

# Misc
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
